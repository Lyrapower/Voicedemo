# OPTIONAL — only if you deliberately enabled API auth on LM Studio Local Server.
# Default local setup: no file needed; turn off "require API token" in LM Studio instead.
# Copy to lm_studio.env only when you want to keep auth on:
# LM_STUDIO_API_KEY=your_token_here
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen3-14b-mlx
