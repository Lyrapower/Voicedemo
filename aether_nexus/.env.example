# === RWA on-chain reader (v2; primary Alchemy, second source independent) ===
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-alchemy-key-here
ETH_RPC_URL_2=https://1rpc.io/eth

# === Interactive Brokers ===
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
LIVE_TRADING_ENABLED=false

# === Notifications ===
NOTIFY_CHANNEL=telegram
PUSHOVER_USER=your-user-key
PUSHOVER_TOKEN=your-app-token
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# === ntfy (Grid momentum critical push only) ===
NTFY_TOPIC=your-ntfy-topic
# NTFY_URL=https://ntfy.sh/your-topic
# NTFY_TOKEN=

# === Grid store / compile ===
GRID_EVENTS=http://127.0.0.1:8501/store/events
PREMARKET_COMPILE_TIME=06:45
# Premarket A/B — same pool universe, isolated chains (report-only)
PREMARKET_SONNET_TIME=06:30
# Primary route: CC CLI (claude-sonnet-4-6). No :8503 egress.
PREMARKET_SONNET_CLI_MODEL=claude-sonnet-4-6
MOMENTUM_CRITICAL_SCORE=60

# === Trading Parameters ===
TOP_CANDIDATES=5
CLOSE_MAX_RETRIES=3
CLOSE_RETRY_DELAY=2
TRADING_START=10:00
TRADING_END=15:00

# === Scan Parameters ===
SCAN_MAX_SYMBOLS=30
SCAN_SLEEP_SEC=0.10
SCAN_MIN_PRICE=20
SCAN_MAX_PRICE=1200
SCAN_MIN_DTE=7
SCAN_MAX_DTE=45
SCAN_TARGET_OTM=1.02

# === Daemon Schedule (EST) ===
SCAN_PRE_MARKET=09:40
SCAN_POST_MARKET=15:30
SCAN_REMINDER_MIN=5
MONITOR_INTERVAL_SEC=60
BUY_CHECK_INTERVAL_SEC=120

# === Dry Run R5.4.1 (Alpaca data-hardened — feeds IB buy logic) ===
DRYRUN_ENABLED=true
IB_SCAN_SOURCE=dryrun

# --- Alpaca market data keys (recommended) ---
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
ALPACA_DATA_FEED=iex
ALPACA_OPTION_FEED=indicative
DATA_PROVIDER_ORDER=alpaca,stooq,yfinance
OPTION_PROVIDER_ORDER=alpaca,yfinance
HTTP_TIMEOUT=12
HTTP_RETRIES=2
HTTP_BACKOFF=0.8
STOOQ_SLEEP=1.0
NEAR_STRIKES_PER_EXPIRY=5

GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash
DRYRUN_SCAN_MODE=sp500
POOL_SCAN_ENABLED=true
POOL_SCAN_PRE_MARKET=09:35
POOL_SCAN_POST_MARKET=15:20
POOL_SYMBOLS=MU,MRVL,AMD,HOOD,DELL,APA,OXY,IONQ,NVDA,TSLA,COIN,IREN,CRDO,QCOM,GLW,BABA,SMCI,ANET

# === Paper mock (aether-paper/) ===
PAPER_LOOP_ENABLED=true
PAPER_CRYPTO_ENABLED=true
PAPER_DAILY_TIME=16:40
CRYPTO_PAPER_CLI_TIME=09:10
CRYPTO_PAPER_CLI_MODEL=claude-sonnet-4-6
CRYPTO_PAPER_CLI_LANE=sonnet-4.6

# Off-pool dual-lane (report-only). Pipe format: lane|backend|model|label
# Legacy colon format lane:model:label → cc_cli backend.
# CC CLI: `sonnet` → claude-sonnet-5 (NOT 4.6); use claude-sonnet-4-6 explicitly.
OFFPOOL_TIME=10:50
OFFPOOL_SCHEDULE_TZ=local
OFFPOOL_LANES=sonnet-4.6|cc_cli|claude-sonnet-4-6|SONNET 4.6,deepseek-v4|ollama_cloud|deepseek-v4-flash:cloud|DEEPSEEK V4
OFFPOOL_CLI_TIMEOUT=180
OFFPOOL_DEEPSEEK_MODEL=deepseek-v4-flash:cloud
OFFPOOL_DEEPSEEK_TIMEOUT=300
OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat
GRID_SCAN_CLI_MODEL=claude-sonnet-4-6

# Premarket DeepSeek V4 (replaces Sonnet CC CLI) — 2× daily local windows
PREMARKET_DEEPSEEK_WINDOWS=premarket:06:40,intraday:10:40
PREMARKET_DEEPSEEK_SCHEDULE_TZ=local
PREMARKET_DEEPSEEK_MODEL=deepseek-v4-flash:cloud
PREMARKET_DEEPSEEK_TIMEOUT=300
DRYRUN_SCAN_MAX_SYMBOLS=0
DRYRUN_SCAN_ON_START=false
LOGGING_FIRST=true
BFS_STAGE1_KEEP=60
BFS_STAGE2_KEEP=20
STAGE1_MIN_DOLLAR_VOL=20000000
STAGE1_SECTOR_CAP_DIV=4
YF_SLEEP=0.6
MAX_EXPIRIES_PER_SYMBOL=3
EARNINGS_CACHE_DAYS=3
RISK_FREE_RATE=0.05
THETA_RATIO_SHORT=0.12
THETA_RATIO_MID=0.08
THETA_RATIO_LONG=0.055
HV_RANK_WINDOW=21
IV_VALUE_WEIGHT=10
IV_RANK_MIN_SAMPLES=60
EARNINGS_WINDOW_MIN=3
EARNINGS_WINDOW_MAX=7
EARNINGS_SCORE_BOOST=10
DRYRUN_MAX_SIGNAL_ROUNDS=90
CAPITAL_PER_TRADE=1000.0
DRYRUN_MIN_DELTA=0.25
DRYRUN_MAX_DELTA=0.50
DRYRUN_MIN_GAMMA=0.01
DRYRUN_MAX_THETA_RATIO=0.08
DRYRUN_MAX_IV=0.80
DRYRUN_MIN_VOLUME=10
DRYRUN_MIN_OPEN_INTEREST=50
DRYRUN_MAX_SPREAD_PCT=0.10
PERILLA_SCAN_TIME=08:30
PERILLA_REMINDER_MIN=5
WATCHLIST_BUY_SCORE_MIN=35
WATCHLIST_BUY_REMINDER=09:40
WATCHLIST_BUY_REMINDER_PM=15:25
