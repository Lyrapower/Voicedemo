# === Interactive Brokers ===
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1
LIVE_TRADING_ENABLED=false

# === Notifications ===
NOTIFY_CHANNEL=telegram
PUSHOVER_USER=your-user-key
PUSHOVER_TOKEN=your-app-token
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# === Trading Parameters ===
TOP_CANDIDATES=5
CLOSE_MAX_RETRIES=3
CLOSE_RETRY_DELAY=2
TRADING_START=10:00
TRADING_END=15:00

# === Scan Parameters ===
SCAN_MAX_SYMBOLS=30
SCAN_SLEEP_SEC=0.10
SCAN_MIN_PRICE=20
SCAN_MAX_PRICE=1200
SCAN_MIN_DTE=7
SCAN_MAX_DTE=45
SCAN_TARGET_OTM=1.02

# === Daemon Schedule (EST) ===
SCAN_PRE_MARKET=09:40
SCAN_POST_MARKET=15:30
SCAN_REMINDER_MIN=5
MONITOR_INTERVAL_SEC=60
BUY_CHECK_INTERVAL_SEC=120

# === Dry Run R5.4.1 (Alpaca data-hardened — feeds IB buy logic) ===
DRYRUN_ENABLED=true
IB_SCAN_SOURCE=dryrun

# --- Alpaca market data keys (recommended) ---
