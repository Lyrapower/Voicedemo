# === Aether Nexus Crypto V1.2 (现货合规版) ===
# V1.1 (bybit 永续/2x 杠杆) 已整体归档至 desktop_archive/06_crypto/aether_crypto/
# V1.2 = 美国合规现货引擎，Coinbase 主 / Kraken 备，paper→sandbox→live 三档

# --- 交易档位（V1.2 三档） ---
# paper   = 不连交易所私有端，本地构造订单全字段日志（验收默认档）
# sandbox = coinbaseexchange + set_sandbox_mode(True)，真实沙盒 API
# live    = 须同时满足 LIVE_TRADING=true 且 LIVE_ACK=YES_I_AUTHORIZED_LIVE
TRADING_MODE=paper

# --- 交易所（V1.2: 默认 coinbaseexchange，bybit 铲除） ---
EXCHANGE_ID=coinbaseexchange
EXCHANGE_API_KEY=your_key
EXCHANGE_SECRET_KEY=your_secret
# coinbaseexchange 需要 passphrase（sandbox key 在 api-public.sandbox.exchange.coinbase.com 申请）
EXCHANGE_PASSPHRASE=your_passphrase

# --- 合规断言（V1.2 #5: 命中即死） ---
# BLOCKED_EXCHANGES 命中 EXCHANGE_ID 启动即死。bybit/binance 永久禁止。
BLOCKED_EXCHANGES=bybit,binance

# --- live 双闸（V1.2 #6） ---
LIVE_TRADING=false
LIVE_ACK=
# LIVE 档需 LIVE_ACK=YES_I_AUTHORIZED_LIVE（双键防手滑）

# --- 通知（V1.2 #8: 默认空 key 即静默，留删待 Lyra） ---
PUSHOVER_USER=
PUSHOVER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_COOLDOWN=60

# --- 策略参数（V1.2 #4: 无杠杆，即价格百分比） ---
MAX_POSITIONS=3
CAPITAL_PER_TRADE=500.0
# 总敞口上限（USD），live 档零默认必显式
MAX_TOTAL_EXPOSURE=0.0

# V1.2 语义：STOP_LOSS_PCT / TAKE_PROFIT_PCT 是【价格百分比】，不是 ROE。
# 现货无杠杆，价格跌 5% = 仓位亏 5%。默认 SL 0.05 / TP 0.15（现货波动档，Lyra 可调）。
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.15
BLACK_SWAN_THRESHOLD=0.05

# --- 现货宇宙（V1.2 #1: -USD 现货对，env 可扩） ---
SPOT_UNIVERSE=BTC/USD,ETH/USD,SOL/USD

# --- 扫描 ---
SCAN_TOP_SYMBOLS=30
TOP_CANDIDATES=3
MIN_QUOTE_VOLUME_USD=50000000

# --- 调度 (秒) ---
SCAN_INTERVAL=3600
MONITOR_INTERVAL=60
BUY_CHECK_INTERVAL=300
CMD_POLL_INTERVAL=10
