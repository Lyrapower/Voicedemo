# === Aether Nexus Crypto V1.1 ===

# --- 交易所 ---
EXCHANGE_ID=bybit
EXCHANGE_API_KEY=your_key
EXCHANGE_SECRET_KEY=your_secret
# Bybit testnet：ccxt set_sandbox_mode(True)。需 testnet 专用 API key（在 testnet.bybit.com 申请）。
EXCHANGE_TESTNET=true

# --- 通知 ---
PUSHOVER_USER=your_user
PUSHOVER_TOKEN=your_token
TELEGRAM_BOT_TOKEN=your_bot
TELEGRAM_CHAT_ID=your_chat
NOTIFY_COOLDOWN=60

# --- 策略参数（V1.1: 从代码移入 env） ---
MAX_POSITIONS=3
CAPITAL_PER_TRADE=500.0
MAX_LEVERAGE=2
# 语义：保证金盈亏比例 (ROE)，不是价格变动。2x 杠杆下 0.10 = 价格反向 5%。
STOP_LOSS_PCT=0.10
TAKE_PROFIT_PCT=0.30
BLACK_SWAN_THRESHOLD=0.05

# --- 扫描 ---
SCAN_TOP_SYMBOLS=30
TOP_CANDIDATES=3
MIN_QUOTE_VOLUME_USDT=50000000

# --- 调度 (秒) ---
SCAN_INTERVAL=3600
MONITOR_INTERVAL=60
BUY_CHECK_INTERVAL=300
CMD_POLL_INTERVAL=10
