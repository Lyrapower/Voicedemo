# Cache database path (relative to quant_framework root or absolute)
CACHE_PATH=data/cache.db

# Telegram bot (required for bot)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_AUTHORIZED_USERS=123456789,987654321

# Dashboard
DASHBOARD_PORT=8501

# Logging
LOG_LEVEL=INFO

# Cache expiration (days)
FUNDAMENTALS_CACHE_DAYS=30
