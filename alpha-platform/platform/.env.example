GRID_STORE_DIR=/Users/ciciwang/Projects/demo/grid-sovereign-runtime/data
WATCHLIST=
SURFACE_DENY=TSLA,GOOGL,AEHR
HEDGE_SYMBOLS=VIXY,SQQQ,GLD,TLT,UUP
GRID_GATEWAY_URL=http://host.docker.internal:8501
# factory 签链：只挂路径，勿把 key 内容写进环境变量
