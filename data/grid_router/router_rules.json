      "model": "demo/aster",
      "key": ""
    },
    "coder": {
      "style": "openai",
      "url": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5-coder",
      "key": ""
    },
    "cloud": {
      "style": "cli",
      "cmd": [
        "/Users/ciciwang/Projects/demo/aster_grid_v5/.tools/node_modules/.bin/claude",
        "-p",
