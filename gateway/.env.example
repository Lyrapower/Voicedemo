# Bind (default 127.0.0.1)
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8000

# Kill-switch: set to 1 to return 503 on all endpoints
# GATEWAY_KILL=0

# SQLite path (default: gateway/data/gateway.db)
# GATEWAY_DB_PATH=data/gateway.db

# Provider defaults
DEFAULT_CHAT_PROVIDER=claude
DEFAULT_VISION_PROVIDER=gemini
DEFAULT_TTS_PROVIDER=mock

# Provider API keys (optional; missing key triggers failover to mock)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Timeout for provider calls (seconds)
# PROVIDER_TIMEOUT=20
