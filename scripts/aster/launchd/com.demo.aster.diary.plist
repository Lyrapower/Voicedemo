<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.demo.aster.diary</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DEMO_ROOT__/scripts/aster/start_aster_diary.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DEMO_ROOT__/aster-diary</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/demo-aster/diary.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/demo-aster/diary.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Library/Frameworks/Python.framework/Versions/3.13/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>GRID_GATEWAY</key>
    <string>http://127.0.0.1:8501/v1/chat/completions</string>
    <key>GRID_MODEL</key>
    <string>demo/aster</string>
  </dict>
</dict>
</plist>
