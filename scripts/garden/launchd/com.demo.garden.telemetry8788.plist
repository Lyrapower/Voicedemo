<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.demo.garden.telemetry8788</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UVICORN__</string>
    <string>repo.telemetry.stub:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8788</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DEMO_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/demo-garden/telemetry8788.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/demo-garden/telemetry8788.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Library/Frameworks/Python.framework/Versions/3.13/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>TELEMETRY_PORT</key>
    <string>8788</string>
  </dict>
</dict>
</plist>
