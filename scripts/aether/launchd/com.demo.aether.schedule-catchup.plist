<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.demo.aether.schedule-catchup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DEMO_ROOT__/scripts/aether/start_schedule_catchup.sh</string>
    <string>--loop</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DEMO_ROOT__/aether_nexus</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/demo-aether/schedule-catchup.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/demo-aether/schedule-catchup.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Library/Frameworks/Python.framework/Versions/3.13/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>SSL_CERT_FILE</key>
    <string>__SSL_CERT_FILE__</string>
    <key>REQUESTS_CA_BUNDLE</key>
    <string>__SSL_CERT_FILE__</string>
    <key>CC_CLI_EXECUTION_FROZEN</key>
    <string>1</string>
    <key>SCHEDULE_CATCHUP_POLL_SEC</key>
    <string>120</string>
    <key>SCHEDULE_CATCHUP_GRACE_MIN</key>
    <string>3</string>
  </dict>
</dict>
</plist>
