<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.demo.aether.paper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DEMO_ROOT__/scripts/start_paper_gated.sh</string>
    <string>--loop</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DEMO_ROOT__/aether-paper</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/demo-aether/paper.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/demo-aether/paper.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Library/Frameworks/Python.framework/Versions/3.13/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>SSL_CERT_FILE</key>
    <string>__SSL_CERT_FILE__</string>
    <key>REQUESTS_CA_BUNDLE</key>
    <string>__SSL_CERT_FILE__</string>
    <key>PAPER_LOOP_ENABLED</key>
    <string>true</string>
    <key>PAPER_CRYPTO_ENABLED</key>
    <string>true</string>
    <key>PAPER_ASSET_CLASS</key>
    <string>equity</string>
    <key>GRID_EVENTS</key>
    <string>http://127.0.0.1:8501/store/events</string>
  </dict>
</dict>
</plist>
