<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.demo.aether.premarket-sonnet</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__DEMO_ROOT__/scripts/start_premarket_sonnet_gated.sh</string>
    <string>--once</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DEMO_ROOT__/aether_nexus</string>
  <key>RunAtLoad</key>
  <false/>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>40</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>40</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/demo-aether/premarket-sonnet.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/demo-aether/premarket-sonnet.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Library/Frameworks/Python.framework/Versions/3.13/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>SSL_CERT_FILE</key>
    <string>__SSL_CERT_FILE__</string>
    <key>REQUESTS_CA_BUNDLE</key>
    <string>__SSL_CERT_FILE__</string>
    <key>CC_CLI_EXECUTION_FROZEN</key>
    <string>1</string>
  </dict>
</dict>
</plist>
