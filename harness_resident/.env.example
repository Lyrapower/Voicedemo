# Copy to ~/.config/grid/harness_resident.env (or set GRID_HARNESS_ENV).
# Do not keep a live .env under harness_resident/ — it sits inside cc --add-dir.
GRID_RELAY_TOKEN=replace_me
# v1.3: :8787 全端点鉴权 token。不设=无鉴权并在启动时响亮警告。手机端设置面里填同一值。
GRID_HARNESS_TOKEN=replace_me_too
GRID_GATEWAY_TOKEN=

# v1.3: 保持 loopback。LAN 直连必须先设 GRID_HARNESS_TOKEN,再自行改绑定——无 token 不开 LAN。
GRID_BIND_HOST=127.0.0.1
GRID_PORT=8787
